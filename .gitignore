# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# mutation testing (stryker)
/.stryker-tmp
/reports
/stryker-out.txt

# playwright (e2e)
/test-results
/playwright-report
/playwright/.cache

# brainstorming visual companion (local mockups, not committed)
/.superpowers

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# agent framework symlink — per-machine convenience, never commit. A tracked
# symlink breaks Windows CI runners ("Unable to load symbolic/hard linked
# file"). Recreate locally: ln -s .claude .agents
.agents

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files can contain credentials; only the blank template is tracked.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable skill local scratch
PRODUCT.md
.impeccable/

# git worktrees (local scratch)
.worktrees/
.claude/worktrees/
# Per-machine dev-server preview config, not project config.
.claude/launch.json
# Written by the skill-usage hook on every skill call; local only.
.claude/skill-usage.log

# Supabase CLI local state, written by `supabase start`/`db reset`/`test db`
# (the running stack's branch pointer, cached CLI version, generated local
# secrets). Machine-local — never the same across two developers or CI.
supabase/.branches
supabase/.temp

# Local Codex CLI working dir (not part of the project)
.codex/
